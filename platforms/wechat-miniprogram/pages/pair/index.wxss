/* pages/pair/index.wxss */
.container {
  padding: 24rpx;
  min-height: 100vh;
}
.mb-1 { margin-bottom: 8rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mt-1 { margin-top: 8rpx; }
.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.ml-1 { margin-left: 8rpx; }
.w-full { width: 100%; }
.border-b { border-bottom: 1rpx solid #F1F5F9; }

/* 微信用户卡片 */
.wx-icon-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #10B981;
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}
.user-title {
  font-size: 28rpx;
  color: #1E293B;
}
.avatar-large {
  font-size: 52rpx;
  margin-right: 20rpx;
}
.user-nick {
  font-size: 30rpx;
  color: #1E293B;
}
.user-openid {
  margin-top: 4rpx;
  display: flex;
  align-items: center;
}
.copy-hint {
  color: #FF5370;
  margin-left: 10rpx;
  text-decoration: underline;
}
.cloud-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #10B981;
  margin-right: 8rpx;
}

/* 绑定卡片 */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1E293B;
}
.bound-box {
  padding: 20rpx 0;
}
.bound-avatars {
  display: flex;
  align-items: center;
}
.boy-avatar-lg, .girl-avatar-lg {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}
.boy-avatar-lg { background: #3B82F6; }
.girl-avatar-lg { background: #EC4899; }
.heart-pulse {
  font-size: 48rpx;
  margin: 0 24rpx;
}
.bound-names {
  font-size: 32rpx;
  color: #1E293B;
}
.pair-code-box {
  background: #FFF0F3;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #C24B66;
}
.code-val {
  font-size: 28rpx;
  color: #FF5370;
  margin-right: 8rpx;
}
.copy-tag {
  background: #FF5370;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}
.btn-unbind {
  background: transparent;
  color: #94A3B8;
  font-size: 24rpx;
  border: 1rpx solid #E2E8F0;
  border-radius: 999rpx;
  padding: 8rpx 32rpx;
}

/* 未绑定流程 */
.card-inner {
  background: #F8FAFC;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #E2E8F0;
}
.step-title {
  font-size: 26rpx;
  color: #1E293B;
}
.invite-box {
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx dashed #FF8E9E;
}
.invite-code {
  font-size: 36rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  color: #FF5370;
}
.input-row {
  display: flex;
  gap: 12rpx;
}
.input-code {
  background: #FFFFFF;
  border: 1rpx solid #CBD5E1;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
}
.btn-bind {
  background: #FF6B81;
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
  line-height: 2.4;
  margin: 0;
  border: none;
}

/* 原理解析 */
.explainer-card {
  padding: 24rpx 32rpx;
}
.db-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}
.arrow {
  color: #94A3B8;
  font-size: 32rpx;
}
.explainer-content {
  line-height: 1.6;
  border-top: 1rpx dashed #E2E8F0;
  padding-top: 16rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
}
.modal-content {
  width: 100%;
  max-width: 600rpx;
}
.modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1E293B;
  text-align: center;
  margin-bottom: 24rpx;
}
.tab-row {
  display: flex;
  background: #F1F5F9;
  border-radius: 999rpx;
  padding: 6rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #64748B;
  border-radius: 999rpx;
}
.tab-active {
  background: #FFFFFF;
  color: #1E293B;
  font-weight: bold;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
}
.input-field {
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}
