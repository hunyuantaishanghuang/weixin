<!-- pages/adventure/index.wxml -->
<view class="container">
  
  <!-- 分类选择 -->
  <view class="category-tabs flex justify-between mb-3">
    <block wx:for="{{categories}}" wx:key="key">
      <view class="cat-pill {{currentCategory === item.key ? 'cat-active' : ''}}" bindtap="changeCategory" data-key="{{item.key}}">
        <text class="cat-icon">{{item.icon}}</text>
        <text class="cat-name">{{item.name}}</text>
      </view>
    </block>
  </view>

  <!-- 🃏 核心大冒险翻转卡片 -->
  <view class="card adventure-card flex flex-col justify-between" bindtap="toggleFlip">
    <view class="adv-top flex items-center justify-between">
      <view class="badge badge-pink">{{activeCatName}}</view>
      <text class="status-badge {{currentCard.completed ? 'status-done' : ''}}">
        {{currentCard.completed ? '已达成打卡 💖' : '挑战待完成 ⏳'}}
      </text>
    </view>

    <view class="adv-center flex flex-col items-center justify-center">
      <view class="adv-emoji">{{currentCategoryIcon}}</view>
      <view class="adv-text">“{{currentCard.text}}”</view>
      <view class="adv-tip text-xs text-muted" wx:if="{{currentCard.tip}}">💡 {{currentCard.tip}}</view>
    </view>

    <view class="adv-footer flex items-center justify-center text-xs text-muted">
      <text>点击卡片可随时换一换，双方一起挑战~</text>
    </view>
  </view>

  <!-- 操作按钮组 -->
  <view class="action-bar flex justify-between">
    <button class="btn-secondary flex-1" style="margin-right: 16rpx;" bindtap="drawRandomCard">🎲 换一题抽取</button>
    <button class="btn-primary flex-1" bindtap="toggleComplete">
      {{currentCard.completed ? '取消达成' : '完成本次心跳挑战'}}
    </button>
  </view>

  <!-- 历史完成榜 -->
  <view class="section-title mt-4 mb-2">已打卡心动挑战 ({{completedCount}})</view>
  <block wx:for="{{cards}}" wx:key="id">
    <view class="card history-card flex items-center justify-between" wx:if="{{item.completed}}">
      <view class="flex items-center">
        <text class="done-check">✓</text>
        <text class="done-text">{{item.text}}</text>
      </view>
      <text class="done-date text-xs text-muted">甜蜜达成</text>
    </view>
  </block>

</view>
