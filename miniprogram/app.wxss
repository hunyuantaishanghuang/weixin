/**app.wxss**/
page {
  /* 主题色变量：全站统一，便于整体改色 */
  --brand: #FF6B81;
  --brand-light: #FFB6C1;
  --brand-bg: #FFF5F7;
  --text: #333;
  --text-sub: #999;
  --radius: 24rpx;
  --shadow: 0 8rpx 24rpx rgba(255, 107, 129, 0.12);

  background: #f6f6f6;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  color: var(--text);
}

/* 通用按压反馈 */
.press {
  transition: transform 0.12s ease, opacity 0.12s ease;
}
.press-hover {
  transform: scale(0.96);
  opacity: 0.85;
}

/* 通用空状态 */
.empty-state {
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
  padding: 80rpx 40rpx;
  line-height: 1.6;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}