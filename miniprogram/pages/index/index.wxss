.home {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #FF6B81 0%, #FFB6C1 38%, #FFF5F7 100%);
  padding: 60rpx 40rpx 40rpx;
  box-sizing: border-box;
}
/* 柔和光斑装饰 */
.deco {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  opacity: 0.5;
  z-index: 0;
}
.deco1 {
  width: 320rpx; height: 320rpx;
  background: #FFD1DC;
  top: -80rpx; right: -60rpx;
}
.deco2 {
  width: 260rpx; height: 260rpx;
  background: #FF9FB0;
  top: 260rpx; left: -90rpx;
  opacity: 0.35;
}
.header {
  position: relative;
  z-index: 1;
  margin-bottom: 50rpx;
  color: #fff;
}
.greet {
  font-size: 26rpx;
  opacity: 0.92;
  margin-bottom: 10rpx;
}
.title {
  font-size: 56rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 16rpx rgba(255, 107, 129, 0.35);
}
.subtitle {
  font-size: 26rpx;
  margin-top: 14rpx;
  opacity: 0.92;
}
.subtitle.link {
  display: inline-block;
  background: rgba(255, 255, 255, 0.22);
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
}
.grid {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.card {
  position: relative;
  width: 48%;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 30rpx 36rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 129, 0.14);
  box-sizing: border-box;
  transition: transform 0.15s ease;
  animation: cardIn 0.5s ease both;
}
.card:nth-child(1) { animation-delay: 0.04s; }
.card:nth-child(2) { animation-delay: 0.10s; }
.card:nth-child(3) { animation-delay: 0.16s; }
.card:nth-child(4) { animation-delay: 0.22s; }
@keyframes cardIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.card-hover {
  transform: scale(0.96);
  box-shadow: 0 6rpx 18rpx rgba(255, 107, 129, 0.2);
}
.card-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 129, 0.18);
}
.card-name {
  font-size: 34rpx;
  font-weight: bold;
  margin-top: 24rpx;
  color: #333;
}
.card-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  line-height: 1.4;
}
.card-arrow {
  position: absolute;
  right: 28rpx;
  top: 40rpx;
  font-size: 44rpx;
  color: #FFC2CE;
  font-weight: bold;
}
.footer {
  position: relative;
  z-index: 1;
  text-align: center;
  color: #FF6B81;
  font-size: 26rpx;
  margin-top: 30rpx;
  padding: 16rpx;
}
.footer-hover {
  opacity: 0.6;
}
