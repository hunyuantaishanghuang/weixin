.menu {
  min-height: 100vh;
  background: #FFF5F7;
  padding-bottom: 160rpx;
}
.banner {
  background: linear-gradient(135deg, #FF8FA3, #FF6B81);
  color: #fff;
  padding: 40rpx 40rpx 44rpx;
  border-radius: 0 0 36rpx 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(255,107,129,0.25);
}
.banner-title { font-size: 40rpx; font-weight: bold; }
.banner-sub { font-size: 24rpx; margin-top: 10rpx; opacity: 0.9; }
.tabs {
  display: flex;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 5;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #999;
  border-bottom: 4rpx solid transparent;
}
.tab.active {
  color: #FF6B81;
  font-weight: bold;
  border-bottom-color: #FF6B81;
}
.list { padding: 24rpx 32rpx; }
.dish, .order {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(255,107,129,0.08);
}
.dish-img { width: 110rpx; height: 110rpx; border-radius: 16rpx; }
.dish-img.placeholder {
  display: flex; align-items: center; justify-content: center;
  background: #FFEAF0; font-size: 48rpx;
}
.dish-info { flex: 1; margin: 0 20rpx; }
.dish-name { font-size: 32rpx; font-weight: bold; color: #333; }
.dish-mat { font-size: 24rpx; color: #888; margin-top: 6rpx; }
.dish-note { font-size: 22rpx; color: #bbb; margin-top: 4rpx; }
.order-btn {
  background: #FF6B81; color: #fff; font-size: 26rpx;
  border-radius: 30rpx; padding: 12rpx 28rpx; margin: 0;
}
.order { }
.order.done { opacity: 0.55; }
.check { font-size: 40rpx; margin-right: 20rpx; }
.order-info { flex: 1; }
.order-name { font-size: 30rpx; color: #333; font-weight: bold; }
.order-mat { font-size: 24rpx; color: #888; margin-top: 6rpx; }
.del { color: #ccc; font-size: 32rpx; padding: 0 10rpx; }
.empty { text-align: center; color: #bbb; font-size: 26rpx; padding: 60rpx 0; }
.fab {
  position: fixed; right: 40rpx; bottom: 60rpx;
  background: #FF6B81; color: #fff; font-size: 30rpx;
  padding: 24rpx 40rpx; border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(255,107,129,0.4);
}
.mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.5);
  display: flex; align-items: flex-end; z-index: 10;
}
.sheet {
  background: #fff; width: 100%; border-radius: 28rpx 28rpx 0 0;
  padding: 40rpx; box-sizing: border-box;
}
.sheet-title { font-size: 34rpx; font-weight: bold; text-align: center; margin-bottom: 30rpx; }
.field { margin-bottom: 24rpx; }
.label { font-size: 26rpx; color: #666; display: block; margin-bottom: 10rpx; }
.input {
  background: #F6F6F6; border-radius: 12rpx; padding: 20rpx;
  font-size: 28rpx;
}
.img-row { display: flex; align-items: center; }
.img-prev { width: 120rpx; height: 120rpx; border-radius: 12rpx; margin-right: 20rpx; }
.img-add {
  width: 120rpx; height: 120rpx; border: 2rpx dashed #FFB6C1; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center; color: #FF6B81; font-size: 24rpx;
}
.ai-box {
  background: #FFF7F9; border: 2rpx solid #FFE0E8; border-radius: 16rpx;
  padding: 24rpx; margin: 20rpx 0;
}
.paste {
  width: 100%; height: 140rpx; background: #fff; border-radius: 12rpx;
  padding: 16rpx; box-sizing: border-box; font-size: 26rpx; margin: 12rpx 0;
}
.ai-btn {
  background: linear-gradient(135deg,#A18CD1,#FBC2EB); color: #fff;
  font-size: 28rpx; border-radius: 30rpx; padding: 16rpx 0;
}
.sheet-actions { display: flex; gap: 20rpx; margin-top: 10rpx; }
.btn { flex: 1; border-radius: 30rpx; font-size: 30rpx; padding: 18rpx 0; }
.btn.primary { background: #FF6B81; color: #fff; }
.btn.ghost { background: #F2F2F2; color: #666; }
