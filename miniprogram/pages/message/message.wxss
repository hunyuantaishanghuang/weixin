.msg { min-height: 100vh; background: #FFF5F7; display: flex; flex-direction: column; }
.chat { flex: 1; padding: 32rpx; overflow-y: auto; }
.bubble {
  max-width: 70%; margin-bottom: 24rpx; padding: 20rpx 26rpx;
  background: #fff; border-radius: 20rpx 20rpx 20rpx 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.bubble.mine {
  margin-left: auto; background: #FF6B81; color: #fff;
  border-radius: 20rpx 20rpx 4rpx 20rpx;
}
.content { font-size: 30rpx; line-height: 1.5; word-break: break-all; }
.time { font-size: 20rpx; opacity: 0.6; margin-top: 10rpx; }
.empty { text-align: center; color: #bbb; font-size: 26rpx; padding: 80rpx 0; }
.input-bar {
  display: flex; align-items: center; padding: 20rpx 24rpx;
  background: #fff; border-top: 2rpx solid #f0f0f0; gap: 16rpx;
}
.love-btn {
  background: #FFEAF0; color: #FF6B81; font-size: 24rpx; padding: 14rpx 20rpx;
  border-radius: 30rpx; margin: 0; flex-shrink: 0;
}
.input {
  flex: 1; background: #F6F6F6; border-radius: 30rpx; padding: 18rpx 28rpx; font-size: 28rpx;
}
.send-btn {
  background: linear-gradient(135deg, #FF8FA3, #FF6B81); color: #fff; font-size: 28rpx; padding: 14rpx 32rpx;
  border-radius: 30rpx; margin: 0; flex-shrink: 0; box-shadow: 0 6rpx 16rpx rgba(255,107,129,0.3);
}
