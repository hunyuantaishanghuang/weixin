/* pages/home/index.wxss */
.container {
  padding: 24rpx;
  min-height: 100vh;
}

/* 顶部浪漫卡片 */
.hero-card {
  background: linear-gradient(135deg, #FFF0F3 0%, #FFE5EC 50%, #FFD8E2 100%);
  border: 1rpx solid rgba(255, 107, 129, 0.2);
}
.heart-icon {
  margin-right: 8rpx;
  font-size: 26rpx;
}
.hero-greeting {
  font-size: 24rpx;
  color: #C24B66;
  font-weight: 500;
}
.days-badge {
  font-size: 22rpx;
  color: #64748B;
}
.days-num {
  font-size: 26rpx;
  font-weight: bold;
  color: #FF5370;
}
.hero-title {
  font-size: 38rpx;
  font-weight: 900;
  color: #1E293B;
  margin: 16rpx 0 24rpx;
  font-family: serif;
}
.couple-lockup {
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 107, 129, 0.15);
}
.avatar-group {
  margin-right: 16rpx;
}
.avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFFFFF;
}
.boy-avatar {
  background-color: #3B82F6;
  z-index: 2;
}
.girl-avatar {
  background-color: #EC4899;
  margin-left: -14rpx;
  z-index: 1;
}
.names-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
}
.pair-tag {
  font-size: 22rpx;
  color: #94A3B8;
  margin-left: 8rpx;
}
.arrow {
  font-size: 36rpx;
  color: #94A3B8;
}

/* 雷达卡片 */
.radar-card {
  position: relative;
  overflow: hidden;
}
.radar-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #10B981;
  margin-right: 12rpx;
}
.radar-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1E293B;
}
.radar-main {
  margin: 20rpx 0;
}
.distance-val {
  font-size: 30rpx;
  font-weight: bold;
  color: #0F172A;
}
.distance-num {
  font-size: 40rpx;
  color: #FF5370;
}
.distance-sub {
  font-size: 24rpx;
  color: #64748B;
  margin-top: 6rpx;
}
.radar-circle {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: #FFF0F3;
  border: 2rpx solid #FF8E9E;
  position: relative;
}
.radar-heart {
  font-size: 38rpx;
}
.location-detail {
  padding: 18rpx 0;
  border-top: 1rpx solid #F1F5F9;
  border-bottom: 1rpx solid #F1F5F9;
}
.loc-item {
  display: flex;
  flex-direction: column;
}
.loc-role {
  font-size: 22rpx;
  color: #64748B;
  margin-bottom: 4rpx;
}
.loc-text {
  font-size: 24rpx;
  color: #1E293B;
  font-weight: 500;
}
.poke-bar {
  margin-top: 20rpx;
}
.poke-btn {
  background: #F8FAFC;
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 500;
  color: #475569;
  border: 1rpx solid #E2E8F0;
}
.poke-btn text:first-child {
  margin-right: 6rpx;
}

/* 4个磁贴卡片 */
.grid-cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.grid-card {
  width: 48%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 250rpx;
  margin-bottom: 24rpx;
}
.grid-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #fff;
}
.bg-amber { background: linear-gradient(135deg, #F59E0B, #FB923C); }
.bg-rose { background: linear-gradient(135deg, #F43F5E, #FB7185); }
.bg-purple { background: linear-gradient(135deg, #8B5CF6, #A855F7); }
.bg-green { background: linear-gradient(135deg, #10B981, #34D399); }

.grid-badge {
  font-size: 20rpx;
  color: #94A3B8;
}
.grid-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1E293B;
  margin-top: 14rpx;
}
.grid-desc {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 4rpx;
}
