/* pages/calendar/index.wxss */
.container {
  padding: 24rpx;
  min-height: 100vh;
}
.cal-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
.current-date-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #1E293B;
}
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1E293B;
  margin-top: 10rpx;
}
.mb-1 { margin-bottom: 8rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mt-4 { margin-top: 32rpx; }

/* 心态卡片 */
.mood-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  transition: all 0.2s ease;
}
.mood-card-boy {
  border-left: 8rpx solid #3B82F6;
}
.mood-card-girl {
  border-left: 8rpx solid #EC4899;
}
.role-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
}
.boy-bg { background-color: #EFF6FF; }
.girl-bg { background-color: #FFF0F3; }

.role-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #1E293B;
}
.mood-time {
  margin-top: 2rpx;
}
.mood-tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.mood-emoji {
  margin-right: 6rpx;
  font-size: 28rpx;
}
.mood-body {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #F1F5F9;
}
.mood-content {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.6;
  font-style: italic;
}
.mood-empty {
  padding: 8rpx 0;
}

/* 历史列表 */
.history-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.history-role-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}
.history-name {
  font-size: 26rpx;
  color: #1E293B;
}
.history-date {
  margin-left: 8rpx;
}
.history-mood-badge {
  font-size: 24rpx;
  font-weight: 500;
  color: #475569;
}
.history-text {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.5;
  margin-top: 10rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
}
.modal-content {
  width: 100%;
  max-width: 600rpx;
}
.modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1E293B;
  text-align: center;
  margin-bottom: 24rpx;
}
.role-selector {
  display: flex;
  gap: 16rpx;
}
.role-pill {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #F1F5F9;
  color: #64748B;
}
.role-active-boy {
  background: #3B82F6;
  color: #fff;
  font-weight: bold;
}
.role-active-girl {
  background: #EC4899;
  color: #fff;
  font-weight: bold;
}
.mood-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.mood-option {
  width: 31%;
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}
.mood-option.mood-selected {
  background: #FFF0F3;
  border-color: #FF6B81;
}
.mood-opt-icon {
  font-size: 40rpx;
}
.mood-opt-label {
  font-size: 22rpx;
  margin-top: 6rpx;
  color: #334155;
  font-weight: 500;
}
.textarea-field {
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  width: 100%;
  height: 160rpx;
  margin-bottom: 24rpx;
}
