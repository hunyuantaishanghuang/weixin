/* pages/adventure/index.wxss */
.container {
  padding: 24rpx;
  min-height: 100vh;
}
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mt-4 { margin-top: 32rpx; }
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1E293B;
}

.category-tabs {
  display: flex;
  gap: 12rpx;
}
.cat-pill {
  flex: 1;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 999rpx;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: #64748B;
  transition: all 0.2s ease;
}
.cat-pill.cat-active {
  background: #FFF0F3;
  border-color: #FF6B81;
  color: #FF5370;
  font-weight: bold;
}
.cat-icon {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

/* 核心卡片 */
.adventure-card {
  min-height: 480rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFDFD 100%);
  border: 2rpx solid rgba(255, 107, 129, 0.2);
  margin-bottom: 30rpx;
  padding: 36rpx;
}
.status-badge {
  font-size: 22rpx;
  color: #94A3B8;
  font-weight: 500;
}
.status-done {
  color: #10B981;
  font-weight: bold;
}
.adv-center {
  padding: 40rpx 20rpx;
  text-align: center;
}
.adv-emoji {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}
.adv-text {
  font-size: 34rpx;
  font-weight: bold;
  color: #1E293B;
  line-height: 1.5;
}
.adv-tip {
  margin-top: 16rpx;
}

/* 完成列表 */
.history-card {
  padding: 20rpx 28rpx;
  margin-bottom: 16rpx;
}
.done-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #10B981;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}
.done-text {
  font-size: 26rpx;
  color: #334155;
}
